http://superautopets.com, https://superautopets.com {
    @discord  path /discord /discord/
    @youtube  path /youtube /youtube/
    @email    path /email /email/
    @twitter  path /twitter /twitter/
    @steam    path /steam /steam/
    @android  path /android /android/
    @ios      path /ios /ios/
    @browser  path /browser /browser/

    redir @discord  https://teamwood.games/discord/sap 302
    redir @youtube  https://www.youtube.com/@teamwoodgames 302
    redir @email    mailto:contact@teamwoodgames.com 302
    redir @twitter  https://teamwood.games/twitter/sap 302
    redir @steam    https://teamwood.games/steam 302
    redir @android  https://teamwood.games/playstore 302
    redir @ios      https://teamwood.games/appstore 302
    redir @browser  https://teamwood.games/itch 302

    handle {
        header Content-Type "text/html; charset=utf-8"
        respond <<HTML
            <!doctype html>
            <html lang="en">
            <head>
              <meta charset="utf-8">
              <meta name="viewport" content="width=device-width, initial-scale=1">
              <title>Super Auto Pets</title>
              <style>
                html, body { margin: 0; height: 100%; background: #000; }
                iframe { border: 0; width: 100%; height: 100%; display: block; }
              </style>
            </head>
            <body>
              <iframe src="https://teamwoodgames.com/"
                allow="fullscreen; autoplay; clipboard-write; gamepad"
                sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation allow-pointer-lock allow-downloads allow-modals"
                allowfullscreen></iframe>
            </body>
            </html>
            HTML 200
    }
}

