  handle_path /resume* {
    rewrite * /MSWS/Resume/main/Resume.pdf 
    reverse_proxy https://raw.githubusercontent.com {
      header_up Host raw.githubusercontent.com
      header_down Content-Type application/pdf
    }
  }

  handle_path /tetris {
