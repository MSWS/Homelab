{
  email imodmaker@gmail.com
  acme_ca https://acme-v02.api.letsencrypt.org/directory
  acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

  # Certificates for the layer4 mail servers below. The l4 `tls` handler only
  # terminates TLS, it does not manage certificates, so these names are
  # automated here rather than via a site block (requires Caddy >= 2.11.6).
  tls_automate_names imap.local.msws.xyz smtp.local.msws.xyz

  # protonmail-bridge speaks plaintext IMAP/SMTP on the `local` network and
  # expects a TLS-terminating proxy in front; these are raw TCP protocols, not
  # HTTP, so they are handled by the layer4 app, matched on TLS SNI.
  layer4 {
    :993 {
      @imaps tls sni imap.local.msws.xyz
      route @imaps {
        tls
        proxy protonmail-bridge:143
      }
    }
    :465 {
      @submissions tls sni smtp.local.msws.xyz
      route @submissions {
        tls
        proxy protonmail-bridge:25
      }
    }
  }

  servers {
    listener_wrappers {
      layer4 {
        @ssh ssh
        route @ssh {
          proxy gitea-server-1:22
        }
        route
      }
      tls
    }
  }

  metrics {
    per_host
  }

  log {
    output stdout
    format console
  }
}

registry.msws.xyz {
  log {
    output stdout
    format console
  }

  @registry_api {
    path /v2/*
  }

  handle @registry_api {
    reverse_proxy gitea-server-1:3000
  }

  handle {
    respond "Access Denied" 403
  }
}

